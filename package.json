{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "cloudflare:build": "mkdir -p ${XDG_CONFIG_HOME:-/tmp/rfz-xdg} && XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-/tmp/rfz-xdg} opennextjs-cloudflare build",
    "cloudflare:dev": "npm run cloudflare:build && XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-/tmp/rfz-xdg} wrangler dev",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@netlify/plugin-nextjs": "^5.16.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "lucide-react": "^1.48.0",
    "next": "^16.4.2",
    "postcss": "^8.5.31",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.2.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@opennextjs/cloudflare": "1.20.9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.5",
    "vitest": "^5.0.3",
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "@types/node": "^22.0.0",
    "undici": "7.30.1"
  }
}
