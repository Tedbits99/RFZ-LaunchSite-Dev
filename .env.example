# Supabase (auto-configured in Bolt)
# SUPABASE_SERVICE_ROLE_KEY is required for server-side admin operations
# (payment creation, webhook processing, fulfillment, order management).
# Find it in: Supabase Dashboard → Settings → API → Project API keys → service_role
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=https://runfazone.com
AUTH_SECRET=

# Server-only HMAC secrets (generate with: openssl rand -hex 32)
RFZ_CUSTOMER_CONFIRMATION_RESEND_HMAC_SECRET=
RFZ_RECOVERY_PROOF_HMAC_SECRET=

# Payments
PAYMENT_PROVIDER=mock
GCASH_API_KEY=
GCASH_SECRET=
MAYA_API_KEY=
MAYA_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Titan Business Email — SMTP credentials stored as Edge Function secrets)
# These are NOT in .env — they are configured in Supabase Edge Function secrets.
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=465
# SMTP_USER=orders@runfazone.com
# SMTP_PASSWORD= (your Titan mailbox password)

# Storage
STORAGE_BUCKET=

# Supplier API Keys (server-side only — also available via Edge Function secrets)
SUPPLIER_FAZERCARDS_API_KEY=

# Placeholder — the real SUPABASE_SERVICE_ROLE_KEY is injected at runtime from the hosted Secrets store (not stored in this file).
